% Citações autor-data e destinos da lista de referências.
\newcommand{\abntentry}[4]{\csdef{abU@#1}{#2}\csdef{abN@#1}{#3}\csdef{abY@#1}{#4}}
\newcommand{\abntlookup}[2]{\ifcsdef{ab#1@#2}{\csuse{ab#1@#2}}{\textbf{??}\PackageWarning{conjecturas_lp_estilo}{Undefined citation #2}}}
\newcommand{\abntpar}[1]{\hyperlink{bib:#1}{\abntlookup{U}{#1}, \abntlookup{Y}{#1}}}
\newcommand{\abntsep}{}
\newcommand{\abntpitem}[1]{\abntsep\renewcommand{\abntsep}{; }\abntpar{#1}}
\newcommand{\citep}[2][]{\begingroup\renewcommand{\abntsep}{}(\forcsvlist{\abntpitem}{#2}\ifblank{#1}{}{, #1})\endgroup}
\newcount\abntn \newcount\abnti
\newcommand{\abntcnt}[1]{\advance\abntn by 1 }
\newcommand{\abnttitem}[1]{\advance\abnti by 1 \ifnum\abnti>1 \ifnum\abnti=\abntn{}\articleand\else, \fi\fi
 \hyperlink{bib:#1}{\abntlookup{N}{#1}} (\hyperlink{bib:#1}{\abntlookup{Y}{#1}}\ifnum\abnti=\abntn\abntoptc\fi)}
\newcommand{\citet}[2][]{\begingroup\ifblank{#1}{\def\abntoptc{}}{\def\abntoptc{, #1}}\abntn=0 \forcsvlist{\abntcnt}{#2}\abnti=0 \forcsvlist{\abnttitem}{#2}\endgroup}
\newcommand{\abntref}[2]{\par\begingroup\interlinepenalty=10000\relax\hypertarget{bib:#1}{}#2\par\endgroup}
\newcommand{\articlereferences}{%
  \ifbesovenglish\clearpage\fi
