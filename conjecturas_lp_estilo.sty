\newcommand{\articleappendix}{%
  \par\Needspace{6\baselineskip}%
  \appendix
  \ifbesovabnt
    \titleformat{\section}[block]{\centering\large\besovheading}%
      {Apêndice \thesection\space\textendash}{.55em}{}%
  \else
    \titleformat{\section}[hang]{\large\besovheading}%
      {\appendixname~\thesection\space\textendash}{.55em}{}%
  \fi
}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcommand{\tablehead}[1]{{\besovheading #1}}
\newcommand{\tablecolors}{%
  \ifbesovabnt\else\arrayrulecolor{besovRule}\rowcolors{1}{white}{besovStripe}\fi
}
