% Os argumentos mantêm as duas colunas e as legendas de continuação alinhadas.
\NewDocumentEnvironment{leantable}{mmmmb}{%
  \begingroup\small
  \ifbesovabnt\renewcommand{\LTcaptype}{quadro}\fi
  \setlength{\tabcolsep}{5pt}
  \renewcommand{\arraystretch}{\ifbesovabnt 1.13\else 1.28\fi}
  \tablecolors
  \begin{longtable}{L{.32\linewidth}L{\dimexpr.68\linewidth-4\tabcolsep\relax}}
  \caption{#1}\label{#2}\\
  \toprule
  \tablehead{#3} & \tablehead{#4}\\
  \midrule
  \endfirsthead
  \caption[]{#1\space(\articlecontinued)}\\
  \toprule
  \tablehead{#3} & \tablehead{#4}\\
  \midrule
  \endhead
  \midrule
  \endfoot
  \bottomrule
  \ifbesovabnt
    \multicolumn{2}{@{}l@{}}{\small Fonte: elaboração própria.}\\
  \fi
  \endlastfoot
  #5
  \end{longtable}
  \endgroup
}{}

