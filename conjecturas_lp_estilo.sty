\newcommand{\besovheading}{\bfseries\color{besovInk}\ifbesovabnt\else\sffamily\fi}
\titleformat{\section}{\large\besovheading}{\thesection}{0.65em}{}
\titleformat{\subsection}{\normalsize\besovheading}{\thesubsection}{0.65em}{}
\ifbesovabnt
  \titleformat{name=\section,numberless}{\centering\large\besovheading}{}{0pt}{}
\fi
\titlespacing*{\section}{0pt}{2.4ex plus .6ex minus .2ex}{1.05ex plus .2ex}
\titlespacing*{\subsection}{0pt}{2.1ex plus .4ex minus .2ex}{.8ex plus .2ex}

\newcommand{\articletitle}[4]{%
  \thispagestyle{plain}%
  \begingroup
  \parindent=0pt
  \ifbesovabnt
    \centering{\Large\bfseries #1\par}%
    \smallskip
    \foreignlanguage{english}{\textit{#4}}\par
    \medskip Victor Gabriel de Oliveira\par
    {\small #2\par}%
  \else
    \noindent{\color{besovRule}\rule{\linewidth}{.8pt}}\par
    \vspace{.75em}%
    {\raggedright\LARGE\besovheading #1\par}%
    \medskip
    {\large Victor Gabriel de Oliveira\par}%
    \smallskip
    {\small #2 \enspace\textperiodcentered\enspace #3\par}%
  \fi
  \endgroup
  \medskip
}
\newcommand{\articleabstract}[5]{%
  \begin{otherlanguage}{#1}%
  \pdfbookmark[1]{#2}{besov.#1.abstract}%
  \ifbesovabnt
    \section*{#2}%
    \noindent #3\par
    \smallskip
    \noindent\textbf{#4:} #5\par
  \else
    \begin{tcolorbox}[colback=besovTint,colframe=besovRule,boxrule=0pt,
      leftrule=1.5pt, sharp corners,boxsep=0pt,left=12pt,right=12pt,
      top=9pt,bottom=9pt,before skip=8pt,after skip=8pt]
      {\besovheading #2\par}\smallskip
      \small\noindent #3\par
      \smallskip
      \footnotesize\noindent{\besovheading #4}\enspace #5
    \end{tcolorbox}%
  \fi
  \end{otherlanguage}%
}

