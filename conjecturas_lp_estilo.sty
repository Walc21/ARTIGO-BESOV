  \ifbesovabnt\smallskip\noindent Fonte: elaboração própria.\par\fi
}
\long\def\@makecaption#1#2{%
  \vskip\abovecaptionskip
  {\small\raggedright\textbf{#1}\enspace\textendash\enspace #2\par}%
  \vskip\belowcaptionskip
}
\setlength{\abovecaptionskip}{4pt}
\setlength{\belowcaptionskip}{6pt}
\renewcommand{\LT@makecaption}[3]{%
  \LT@mcol\LT@cols{@{}l@{}}{\parbox[t]{\LTcapwidth}{%
    \small\raggedright\strut #1{\textbf{#2}\enspace\textendash\enspace}#3\strut\par
    \vspace{4pt}}}%
}
